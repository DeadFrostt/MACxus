Media Foundation software video output on macOS, for the Highball engine
(CrossOver 26.3 Wine sources, crossover-sources-26.3.0.tar.gz).

Patches 0004, 0005 and 0007 of github.com/Jfishin/winevideo (commit 523a3dd),
combined; 0007's vp9_decoder_create hunk is dropped (that decoder comes from
winevideo's VP9 patch, not used here). Wine is LGPL-2.1-or-later and so are
these changes to it.

- mfplat: D3D11 NV12 textures fall back to BGRA.
- winegstreamer: on macOS the video decoder is not D3D-aware, refuses a D3D
  manager and always provides IMF2DBuffer system-memory samples, so UE5
  ElectraPlayer (Halo: Campaign Evolved) gets frames.

Build (PE side only, matches the engine's winegstreamer.so):
  configure --host=x86_64-apple-darwin --enable-win64 --enable-archs=x86_64
            --without-gstreamer --enable-winegstreamer (+ the usual --without-*)
  make dlls/winegstreamer/x86_64-windows/winegstreamer.dll \
       dlls/mfplat/x86_64-windows/mfplat.dll
  x86_64-w64-mingw32-strip --strip-debug, then put both DLLs in
  <MACxus data>/highball-overrides/.

diff --git a/dlls/mfplat/sample.c b/dlls/mfplat/sample.c
index 4d75924..805adca 100644
--- a/dlls/mfplat/sample.c
+++ b/dlls/mfplat/sample.c
@@ -1491,6 +1491,27 @@ static HRESULT sample_allocator_initialize(struct sample_allocator *allocator, u
     if (FAILED(hr = sample_allocator_get_surface_service(allocator, &service)))
         return hr;
 
+    /* Some D3D11 backends (notably CrossOver's d3dmetal, which has no
+     * MTLPixelFormat for NV12) cannot create YUV textures: CreateTexture2D with
+     * an unsupported format yields an invalid Metal descriptor and aborts the
+     * whole process. Honor CheckFormatSupport and fall back to B8G8R8A8 so the
+     * texture is always creatable instead of crashing. */
+    if (service.d3d11_device && allocator->frame_desc.dxgi_format != DXGI_FORMAT_B8G8R8A8_UNORM
+            && allocator->frame_desc.dxgi_format != DXGI_FORMAT_B8G8R8X8_UNORM)
+    {
+        UINT support = 0;
+        if (FAILED(ID3D11Device_CheckFormatSupport(service.d3d11_device,
+                allocator->frame_desc.dxgi_format, &support))
+                || !(support & D3D11_FORMAT_SUPPORT_TEXTURE2D))
+        {
+            WARN("D3D11 device cannot create %#x as a texture; falling back to B8G8R8A8_UNORM.\n",
+                    allocator->frame_desc.dxgi_format);
+            allocator->frame_desc.dxgi_format = DXGI_FORMAT_B8G8R8A8_UNORM;
+            if (!allocator->frame_desc.bindflags)
+                allocator->frame_desc.bindflags = D3D11_BIND_SHADER_RESOURCE;
+        }
+    }
+
     sample_allocator_release_samples(allocator);
 
     for (i = 0; i < sample_count; ++i)
diff --git a/dlls/winegstreamer/video_decoder.c b/dlls/winegstreamer/video_decoder.c
index 0f40241..95a4ac1 100644
--- a/dlls/winegstreamer/video_decoder.c
+++ b/dlls/winegstreamer/video_decoder.c
@@ -106,6 +106,7 @@ struct video_decoder
 
     IMFVideoSampleAllocatorEx *allocator;
     BOOL allocator_initialized;
+    BOOL have_d3d_manager;
     IMFTransform *copier;
     IMFMediaBuffer *temp_buffer;
 
@@ -605,8 +606,12 @@ static HRESULT WINAPI transform_GetOutputAvailableType(IMFTransform *iface, DWOR
     if (index >= decoder->output_type_count)
         return MF_E_NO_MORE_TYPES;
 
-    /* CW HACK 26265 */
-    if (is_macos() && IsEqualGUID(decoder->output_types[index], &MFVideoFormat_NV12))
+    /* CW HACK 26265, narrowed by winevideo: NV12 is only poisonous when the
+     * output is bound to a D3D device (no macOS backend can create NV12
+     * D3D11 textures). As a plain system-memory format it is fine, and UE
+     * Electra's software path requires it to be enumerable. */
+    if (is_macos() && decoder->have_d3d_manager
+            && IsEqualGUID(decoder->output_types[index], &MFVideoFormat_NV12))
     {
         WARN("Skipping NV12 output format\n");
         index++;
@@ -863,11 +868,21 @@ static HRESULT WINAPI transform_ProcessMessage(IMFTransform *iface, MFT_MESSAGE_
     switch (message)
     {
     case MFT_MESSAGE_SET_D3D_MANAGER:
+        /* winevideo: no macOS backend can make NV12/D3D11 video textures, so
+         * D3D-bound output starves direct-IMFTransform consumers (UE Electra).
+         * Refuse the manager like a non-D3D-aware MFT would; callers then use
+         * their software path and upload CPU frames themselves. */
+        if (is_macos() && param)
+        {
+            WARN("Refusing D3D device manager on macOS; forcing system-memory output.\n");
+            return E_NOTIMPL;
+        }
         if (FAILED(hr = IMFVideoSampleAllocatorEx_SetDirectXManager(decoder->allocator, (IUnknown *)param)))
             return hr;
 
         uninit_allocator(decoder);
-        if (param)
+        decoder->have_d3d_manager = !!param;
+        if (param || is_macos())
             decoder->output_info.dwFlags |= MFT_OUTPUT_STREAM_PROVIDES_SAMPLES;
         else
             decoder->output_info.dwFlags &= ~MFT_OUTPUT_STREAM_PROVIDES_SAMPLES;
@@ -1672,13 +1687,24 @@ static HRESULT video_decoder_create_with_types(const GUID *const *input_types, U
         goto failed;
     if (FAILED(hr = MFCreateAttributes(&decoder->attributes, 16)))
         goto failed;
+    /* winevideo: on macOS, advertise no D3D awareness at all — D3D-bound
+     * output would need NV12 D3D11 textures no backend can create. Callers
+     * (UE Electra, SourceReader) then take their software/system-memory
+     * paths, which work. */
     if (FAILED(hr = IMFAttributes_SetUINT32(decoder->attributes, &MF_LOW_LATENCY, FALSE))
-            || FAILED(hr = IMFAttributes_SetUINT32(decoder->attributes, &MF_SA_D3D_AWARE, TRUE))
-            || FAILED(hr = IMFAttributes_SetUINT32(decoder->attributes, &MF_SA_D3D11_AWARE, TRUE))
+            || FAILED(hr = IMFAttributes_SetUINT32(decoder->attributes, &MF_SA_D3D_AWARE, !is_macos()))
+            || FAILED(hr = IMFAttributes_SetUINT32(decoder->attributes, &MF_SA_D3D11_AWARE, !is_macos()))
             || FAILED(hr = IMFAttributes_SetUINT32(decoder->attributes,
                     &MFT_DECODER_EXPOSE_OUTPUT_TYPES_IN_NATIVE_ORDER, FALSE)))
         goto failed;
 
+    /* winevideo: on macOS always provide output samples ourselves — the
+     * sample allocator's system-memory buffers implement IMF2DBuffer, which
+     * consumers like UE Electra require on video frames (a caller-provided
+     * plain memory buffer does not, so they reject every frame). */
+    if (is_macos())
+        decoder->output_info.dwFlags |= MFT_OUTPUT_STREAM_PROVIDES_SAMPLES;
+
     if (FAILED(hr = MFCreateAttributes(&decoder->output_attributes, 0)))
         goto failed;
     if (FAILED(hr = wg_sample_queue_create(&decoder->wg_sample_queue)))
@@ -1753,7 +1779,7 @@ HRESULT h264_decoder_create(REFIID riid, void **out)
     decoder->input_info.dwFlags = MFT_INPUT_STREAM_WHOLE_SAMPLES | MFT_INPUT_STREAM_SINGLE_SAMPLE_PER_BUFFER
             | MFT_INPUT_STREAM_FIXED_SAMPLE_SIZE;
     decoder->input_info.cbSize = 0x1000;
-    decoder->output_info.dwFlags = MFT_OUTPUT_STREAM_WHOLE_SAMPLES | MFT_OUTPUT_STREAM_SINGLE_SAMPLE_PER_BUFFER
+    decoder->output_info.dwFlags |= MFT_OUTPUT_STREAM_WHOLE_SAMPLES | MFT_OUTPUT_STREAM_SINGLE_SAMPLE_PER_BUFFER
             | MFT_OUTPUT_STREAM_FIXED_SAMPLE_SIZE;
     decoder->output_info.cbSize = 1920 * 1088 * 2;
 
