+        create_macos_launch_view(source, view, &fixture.fds()).unwrap();
+        let decrypted: HashSet<PathBuf> = ["Game.exe", "GameAssembly.dll"].iter().map(PathBuf::from).collect();
+        std::fs::rename(view.join("Game.exe"), view.join("Game.exe.bak")).unwrap();
+        std::fs::create_dir(view.join("Backup")).unwrap();
+        std::fs::copy(view.join("GameAssembly.dll"), view.join("Backup/GameAssembly.dll")).unwrap();
+        std::fs::write(view.join("Saved.ini"), b"[Core]").unwrap();
+        assert_eq!(sync_back(view, source, &decrypted, &fixture.image_sizes()).unwrap(), 1);
