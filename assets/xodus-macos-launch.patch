+        assert!(source.join("Saved.ini").is_file());
+    }
+
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn macos_sync_back_refuses_symlinked_targets_in_the_package() {
+        let fixture = macos_fixture();
