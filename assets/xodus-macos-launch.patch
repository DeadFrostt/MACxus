+        let decrypted: HashSet<PathBuf> = ["Game.exe", "GameAssembly.dll"].iter().map(PathBuf::from).collect();
+        // An atomic save replaces the symlink with a regular file.
+        std::fs::remove_file(view.join("Data/a.bin")).unwrap();
+        std::fs::write(view.join("Data/a.bin"), b"saved by game").unwrap();
+        assert_eq!(sync_back(view, source, &decrypted, &fixture.image_sizes()).unwrap(), 1);
+        assert_eq!(std::fs::read(source.join("Data/a.bin")).unwrap(), b"saved by game");
+    }
+
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn macos_sync_back_never_keeps_copies_of_decrypted_images() {
