+// CrossOver's Wine has no WINE_DLL_FILE_MAP/WINE_EXE_FILE_MAP, so on macOS every
+// encrypted image (exe and dll) must exist as a real decrypted file.
+#[cfg(target_os = "macos")]
+fn macos_decrypted_files(encrypted: &[(&String, RawFd)]) -> std::io::Result<HashMap<PathBuf, RawFd>> {
+    encrypted.iter().map(|(name, fd)| Ok((checked_relative_path(name)?, *fd))).collect()
+}
+
+#[cfg(target_os = "macos")]
+fn collect_directories(root: &Path, relative: &Path, found: &mut HashSet<PathBuf>) -> std::io::Result<()> {
+    for item in std::fs::read_dir(root.join(relative))? {
+        let item = item?;
+        if item.file_type()?.is_dir() {
+            let child = relative.join(item.file_name());
+            collect_directories(root, &child, found)?;
+            found.insert(child);
+        }
+    }
+    Ok(())
+}
+
+// Rebuilds the package tree in `view_root` with real directories, decrypted
+// encrypted images and symlinks for everything else, so files the game creates
+// stay in the view (and are copied back by `sync_back`).
+#[cfg(target_os = "macos")]
+fn create_macos_launch_view(
+    source_root: &Path,
+    view_root: &Path,
+    encrypted: &[(&String, RawFd)],
+) -> std::io::Result<()> {
+    let decrypted = macos_decrypted_files(encrypted)?;
+    let mut real_directories = HashSet::new();
+    collect_directories(source_root, Path::new(""), &mut real_directories)?;
+    let decrypted_files: HashSet<PathBuf> = decrypted.keys().cloned().collect();
+    populate_launch_view(source_root, view_root, Path::new(""), &real_directories, &decrypted_files)?;
+    for (relative, fd) in &decrypted {
+        write_launch_stub(&view_root.join(relative), *fd, true)?;
+    }
+    Ok(())
+}
+
+#[cfg(target_os = "macos")]
+fn macos_image_sizes(encrypted: &[(&String, RawFd)]) -> HashSet<u64> {
+    encrypted.iter().filter_map(|(_, fd)| {
+        // Borrow the decrypted image without taking ownership.
+        let image = std::mem::ManuallyDrop::new(unsafe { std::fs::File::from_raw_fd(*fd) });
+        image.metadata().ok().map(|metadata| metadata.len())
+    }).collect()
+}
+
+// A renamed or copied decrypted image must never reach the package folder:
+// any PE file with the size of a decrypted image is treated as one.
+#[cfg(target_os = "macos")]
+fn looks_like_decrypted_image(path: &Path, len: u64, image_sizes: &HashSet<u64>) -> bool {
+    use std::io::Read;
+    if !image_sizes.contains(&len) {
+        return false;
+    }
+    let mut head = [0u8; 2];
+    std::fs::File::open(path).and_then(|mut file| file.read_exact(&mut head)).map_or(true, |_| head == *b"MZ")
+}
+
+// Never write through a symlink inside the package: every existing component
+// of the target must be a real file or directory.
+#[cfg(target_os = "macos")]
+fn package_target_is_safe(source_root: &Path, relative: &Path) -> bool {
+    let mut current = source_root.to_path_buf();
+    for component in relative.components() {
+        current.push(component);
+        match std::fs::symlink_metadata(&current) {
+            Ok(metadata) if metadata.file_type().is_symlink() => return false,
+            Ok(_) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return true,
+            Err(_) => return false,
+        }
+    }
+    true
+}
+
+#[cfg(target_os = "macos")]
+fn sync_back_directory(
+    view_root: &Path,
+    source_root: &Path,
+    relative: &Path,
+    decrypted: &HashSet<PathBuf>,
+    image_sizes: &HashSet<u64>,
+    copied: &mut usize,
+) -> std::io::Result<()> {
+    for item in std::fs::read_dir(view_root.join(relative))? {
+        let item = item?;
+        // .fseventsd, .Trashes, .xodus-owner, ... belong to the volume.
+        if relative.as_os_str().is_empty() && item.file_name().to_string_lossy().starts_with('.') {
+            continue;
+        }
+        let child = relative.join(item.file_name());
+        let file_type = item.file_type()?;
+        if file_type.is_symlink() || decrypted.contains(&child) {
+            continue;
+        }
+        if file_type.is_dir() {
+            sync_back_directory(view_root, source_root, &child, decrypted, image_sizes, copied)?;
+        } else if file_type.is_file() {
+            if looks_like_decrypted_image(&item.path(), item.metadata()?.len(), image_sizes) {
+                eprintln!("not keeping {}: it matches a decrypted package image", child.display());
+                continue;
+            }
+            if !package_target_is_safe(source_root, &child) {
+                eprintln!("not keeping {}: the game folder has a symlink on that path", child.display());
+                continue;
+            }
+            let target = source_root.join(&child);
+            let result = target.parent().map_or(Ok(()), std::fs::create_dir_all)
+                .and_then(|_| std::fs::copy(item.path(), &target));
+            match result {
+                Ok(_) => *copied += 1,
+                Err(error) => eprintln!("could not keep {} written by the game: {error}", child.display()),
+            }
+        }
+    }
+    Ok(())
+}
+
+// Copies regular files the game created or replaced in the launch view back
+// into the package directory before the RAM disk is detached.
+#[cfg(target_os = "macos")]
+fn sync_back(
+    view_root: &Path,
+    source_root: &Path,
+    decrypted: &HashSet<PathBuf>,
+    image_sizes: &HashSet<u64>,
+) -> std::io::Result<usize> {
+    let mut copied = 0;
+    sync_back_directory(view_root, source_root, Path::new(""), decrypted, image_sizes, &mut copied)?;
+    Ok(copied)
+}
+
+#[cfg(target_os = "macos")]
+fn keep_game_files(view_root: &Path, source_root: &Path, decrypted: &HashSet<PathBuf>, image_sizes: &HashSet<u64>) {
+    match sync_back(view_root, source_root, decrypted, image_sizes) {
+        Ok(0) => {}
+        Ok(count) => eprintln!("kept {count} files written by the game in its folder"),
+        Err(err) => eprintln!("could not keep files written by the game: {err}"),
+    }
+}
+
+// Marks a launch-view RAM disk with the PID of the xodus-cli that owns it.
+#[cfg(target_os = "macos")]
+const LAUNCH_VIEW_OWNER: &str = ".xodus-owner";
+
+#[cfg(target_os = "macos")]
+fn is_stale_owner(contents: &str, alive: impl Fn(i32) -> bool) -> bool {
+    match contents.trim().parse::<i32>() {
+        Ok(pid) if pid > 0 => !alive(pid),
+        _ => false,
+    }
+}
+
+#[cfg(target_os = "macos")]
+fn process_alive(pid: i32) -> bool {
+    !matches!(kill(Pid::from_raw(pid), None::<Signal>), Err(nix::errno::Errno::ESRCH))
+}
+
+#[cfg(target_os = "macos")]
+fn plist_string(dict: &str, key: &str) -> Option<String> {
+    let after_key = &dict[dict.find(&format!("<key>{key}</key>"))? + key.len() + 11..];
+    let value = after_key.trim_start().strip_prefix("<string>")?;
+    let value = &value[..value.find("</string>")?];
+    Some(value.replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"")
+        .replace("&apos;", "'").replace("&amp;", "&"))
+}
+
+// (device, mount point) of every mounted entity in `hdiutil info -plist`.
+#[cfg(target_os = "macos")]
+fn attached_mounts(plist: &str) -> Vec<(String, PathBuf)> {
+    plist.split("<dict>").filter_map(|chunk| {
+        let dict = &chunk[..chunk.find("</dict>").unwrap_or(chunk.len())];
+        Some((plist_string(dict, "dev-entry")?, PathBuf::from(plist_string(dict, "mount-point")?)))
+    }).collect()
+}
+
+#[cfg(target_os = "macos")]
+async fn detach_launch_view(mount_point: &Path, device: &str) {
+    match Command::new("/sbin/umount").arg("-f").arg(mount_point).status().await {
+        Ok(status) if status.success() => {}
+        Ok(status) => eprintln!("umount {} failed: {status}", mount_point.display()),
+        Err(err) => eprintln!("umount {} failed: {err}", mount_point.display()),
+    }
+    match Command::new("/usr/bin/hdiutil").arg("detach").arg("-force").arg(device).status().await {
+        Ok(status) if status.success() => {}
+        Ok(status) => eprintln!("hdiutil detach {device} failed: {status}"),
+        Err(err) => eprintln!("hdiutil detach {device} failed: {err}"),
+    }
+    let _ = std::fs::remove_dir(mount_point);
+}
+
+// A launch killed by SIGKILL leaves its RAM disk (with decrypted images)
+// attached; detach those whose owner process is gone. Unmarked disks are
+// never touched.
+#[cfg(target_os = "macos")]
+async fn sweep_stale_launch_views() {
+    let Ok(output) = Command::new("/usr/bin/hdiutil").arg("info").arg("-plist").output().await else {
+        return;
+    };
+    for (device, mount_point) in attached_mounts(&String::from_utf8_lossy(&output.stdout)) {
+        let Ok(owner) = std::fs::read_to_string(mount_point.join(LAUNCH_VIEW_OWNER)) else {
+            continue;
+        };
+        if is_stale_owner(&owner, process_alive) {
+            eprintln!("detaching a stale launch view left by process {} at {}", owner.trim(), mount_point.display());
+            detach_launch_view(&mount_point, &device).await;
+        }
+    }
+}
+
+// Room on the RAM disk for the view's directories, symlinks and game writes.
+#[cfg(target_os = "macos")]
+fn macos_view_reserve(source_root: &Path) -> u64 {
+    fn entries(directory: &Path) -> u64 {
+        std::fs::read_dir(directory).map(|items| items.flatten().map(|item| {
+            1 + if item.file_type().is_ok_and(|kind| kind.is_dir()) { entries(&item.path()) } else { 0 }
+        }).sum()).unwrap_or(0)
+    }
+    128 * 1024 * 1024 + entries(source_root) * 8 * 1024
+}
