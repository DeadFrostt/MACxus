+
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn macos_termination_signals_reach_the_cleanup_handler() {
+        let _ = ctrlc::try_set_handler(|| {});
+        for signal in [nix::libc::SIGTERM, nix::libc::SIGHUP, nix::libc::SIGINT] {
+            let mut current: nix::libc::sigaction = unsafe { std::mem::zeroed() };
+            assert_eq!(unsafe { nix::libc::sigaction(signal, std::ptr::null(), &mut current) }, 0);
+            assert_ne!(current.sa_sigaction, nix::libc::SIG_DFL, "signal {signal} is not handled");
+        }
