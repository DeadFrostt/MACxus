+        let outside = tempfile::tempdir().unwrap();
+        std::fs::write(outside.path().join("victim.ini"), b"outside").unwrap();
+        symlink(outside.path(), source.join("Saved")).unwrap();
+        symlink(outside.path().join("victim.ini"), source.join("Data/user.ini")).unwrap();
+        std::fs::create_dir_all(view.join("Saved")).unwrap();
